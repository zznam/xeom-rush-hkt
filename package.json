{
  "name": "xeom-rush-monorepo",
  "private": true,
  "scripts": {
    "dev:server": "bun run build:core && bun run --filter server dev",
    "dev:client": "bun run build:core && bun run --filter client dev",
    "build:shared": "bun run --filter '@xeom-rush/shared' build",
    "build:server": "bun run build:core && bun run --filter server build",
    "build:client": "bun run build:core && bun run --filter client build",
    "start:server": "bun run --filter server start",
    "test": "bun run --filter '@xeom-rush/shared' test && bun run build:core && bun run --filter '@xeom-rush/game-core' test && bun run --filter server test",
    "test:e2e": "bun run --filter e2e test",
    "bench": "bun run --filter '@xeom-rush/shared' bench",
    "lint": "eslint . --max-warnings 0 && bun run lint:md",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore \"**/dist/**\" --ignore \"**/test-results/**\" --ignore \"**/playwright-report/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:regional": "bun run build:server && node tests/regional-smoke.mjs",
    "test:e2e:regional": "bun run --filter e2e test --config=playwright.regional.config.ts",
    "build:client:legacy": "VITE_DEPLOY_TARGET=legacy bun run build:client",
    "build:client:regional": "VITE_DEPLOY_TARGET=regional-production bun run build:client",
    "build:legacy": "bun run build:server && bun run build:client:legacy",
    "test:legacy": "bun run build:server && node tests/legacy-smoke.mjs",
    "build:core": "bun run build:shared && bun run --filter '@xeom-rush/game-core' build",
    "test:soak": "node tests/release-soak.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "markdownlint-cli": "^0.44.0",
    "prettier": "^3.5.2",
    "typescript-eslint": "^8.24.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix",
      "prettier --write"
    ],
    "*.{json,html,css}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.4.0"
}
